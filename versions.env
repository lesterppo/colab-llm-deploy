# Pinned component versions for colab-llm-deploy.
# deploy_llm.py verifies-or-installs these idempotently on every run,
# so a reclaimed Colab VM always converges to the same state.
OLLAMA=0.34.4
CLOUDFLARED=2026.9.3
VLLM=0.30.0

# transformers must stay below 5.0 on Colab T4 (5.x breaks SDXL-era stacks
# and several quant paths); the vLLM backend installs transformers>=4.46,<5.0.
TRANSFORMERS_UPPER_BOUND=<5.0
